{
  "name": "stet",
  "version": "0.1.0",
  "description": "A thin layer that lets a coding agent build and maintain a markdown wiki for you.",
  "keywords": [
    "claude-code",
    "mcp",
    "wiki",
    "knowledge-base",
    "markdown",
    "agent",
    "obsidian"
  ],
  "homepage": "https://github.com/ethanbch/stet#readme",
  "bugs": {
    "url": "https://github.com/ethanbch/stet/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ethanbch/stet.git"
  },
  "license": "MIT",
  "author": "Ethan Benchetrit",
  "type": "module",
  "bin": {
    "stet": "dist/cli.js"
  },
  "files": [
    "dist",
    "templates",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && npm run build:ui",
    "build:server": "tsc -p tsconfig.json",
    "build:ui": "vite build --config ui/vite.config.ts",
    "dev:ui": "vite --config ui/vite.config.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p ui/tsconfig.json --noEmit",
    "prepack": "npm run build",
    "first-run": "node scripts/first-run.mjs"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "commander": "^15.0.0",
    "gray-matter": "^4.0.3",
    "hono": "^4.13.14",
    "minisearch": "^7.2.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "smol-toml": "^1.9.1",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@lezer/highlight": "^1.2.5",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "force-graph": "^1.52.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
